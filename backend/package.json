{
  "name": "glosir-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "npm run test:all",
    "test:all": "node --test tests/account-management.test.js tests/admin-dashboard-service.test.js tests/app-setting-service.test.js tests/catalog-data-exposure.test.js tests/finance-summary-service.test.js tests/finance-validation.test.js tests/globot.test.js tests/order-reversal.test.js tests/order-whatsapp-message.test.js tests/pagination.test.js tests/phone-utils.test.js tests/phase0-security.test.js tests/phase5-loyalty-expiry.test.js tests/promo-service.test.js tests/route-structure.test.js tests/savings-goal-schema.test.js tests/session-auth.test.js tests/webhook-security.test.js",
    "preflight": "node scripts/dailyPreflight.js",
    "test:security": "node tests/phase0-security.test.js",
    "test:phase1": "node tests/phase1-email-auth.integration.js",
    "test:catalog": "node tests/catalog-data-exposure.test.js",
    "test:session": "node tests/session-auth.test.js",
    "test:webhook": "node tests/webhook-security.test.js",
    "seed:demo": "node scripts/seedDemoPrisma.mjs && node scripts/seedDemoData.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "finance:migrate-data": "node scripts/migrateFinanceData.js",
    "migrate:product-units": "node scripts/migrateProductUnits.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.6",
    "prisma": "^5.7.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "nodemon": "^3.1.14"
  }
}
