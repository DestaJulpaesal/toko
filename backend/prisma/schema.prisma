generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  CASHIER
  PARCEL_MANAGER
}

enum ProductStatus {
  ACTIVE
  DRAFT
  HIDDEN
  OUT_OF_STOCK
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  DEBT
}

enum OrderType {
  STORE
  ONLINE
  WHATSAPP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  HOLD
  COMPLETED
  CANCELLED
  VOIDED
}

enum ParcelType {
  STANDARD
  CUSTOM
}

enum SiteContentType {
  TERMS
  PRIVACY
  CONTACT
  FAQ
  HELP
  TESTIMONIAL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(CASHIER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders               Order[]
  voidedOrders         Order[]                @relation("OrderVoidedBy")
  transactions         FinanceTransaction[]
  regionId             String?
  region               ParcelRegion?          @relation("RegionMembers", fields: [regionId], references: [id], onDelete: SetNull)
  managedRegions       ParcelRegion[]         @relation("RegionManager")
  collectionSessions   CollectionSession[]    @relation("CollectionManager")
  verifiedCollections  CollectionSession[]    @relation("CollectionVerifier")
  stockOpnames         StockOpname[]
  auditLogs            AuditLog[]
  savingsGoals         SavingsGoal[]
  reconciliations      CashReconciliation[]
  financeAuditLogs     FinanceAuditLog[]
  requestedApprovals   FinanceApproval[]      @relation("ApprovalRequestedBy")
  approvedApprovals    FinanceApproval[]      @relation("ApprovalApprovedBy")
  quickTemplates       FinanceQuickTemplate[]
  financeLoggingStreak FinanceLoggingStreak?
  dashboardLayout      Json?
}

model ParcelRegion {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  managerId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manager            User?               @relation("RegionManager", fields: [managerId], references: [id], onDelete: SetNull)
  users              User[]              @relation("RegionMembers")
  participants       ParcelParticipant[] @relation("RegionParticipants")
  collectionSessions CollectionSession[]

  @@index([managerId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders             Order[]
  debts              DebtRecord[]
  parcelParticipants ParcelParticipant[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id            String        @id @default(cuid())
  sku           String        @unique
  name          String
  slug          String        @unique
  description   String?
  categoryId    String
  imageUrl      String?
  status        ProductStatus @default(ACTIVE)
  isFeatured    Boolean       @default(false)
  isParcel      Boolean       @default(false)
  isQuickAccess Boolean       @default(false)
  stockWarning  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category       Category         @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  restockItems   RestockItem[]
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  name           String // e.g. "Bungkus", "Sachet", "Kg"
  sku            String   @unique
  barcode        String?  @unique
  basePrice      Decimal  @db.Decimal(12, 2)
  sellPrice      Decimal  @db.Decimal(12, 2)
  wholesalePrice Decimal? @db.Decimal(12, 2)
  stockQty       Int      @default(0)
  unit           String
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product           Product            @relation(fields: [productId], references: [id])
  orderItems        OrderItem[]
  stockMovements    StockMovement[]
  stockOpnames      StockOpname[]
  eventPackageItems EventPackageItem[]
  parcelItems       ParcelItem[]
  restockItems      RestockItem[]
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  type      String // IN, OUT, ADJUSTMENT, RETURN
  quantity  Int
  note      String?
  reference String?
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

model RestockList {
  id          String   @id @default(cuid())
  status      String   @default("DRAFT")
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items RestockItem[]

  @@index([status, createdAt])
}

model RestockItem {
  id            String   @id @default(cuid())
  restockListId String
  productId     String
  variantId     String
  productName   String
  sku           String
  categoryName  String
  unit          String
  stockQty      Int
  stockWarning  Int
  suggestedQty  Int      @default(0)
  requestedQty  Int      @default(0)
  purchaseUnit  String   @default("unit")
  purchasePrice Decimal? @db.Decimal(12, 2)
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restockList RestockList    @relation(fields: [restockListId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([restockListId, variantId])
  @@index([categoryName, status])
}

model Parcel {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  type        ParcelType @default(STANDARD)
  price       Decimal    @db.Decimal(12, 2)
  imageUrl    String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items             ParcelItem[]
  orderItems        OrderItem[]
  participants      ParcelParticipant[]
  basePrice         Decimal?            @db.Decimal(12, 2)
  managerCommission Decimal             @default(0) @db.Decimal(12, 2)
}

model ParcelProgram {
  id           String   @id @default(cuid())
  name         String
  year         Int
  targetAmount Decimal  @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participants ParcelParticipant[]

  @@unique([name, year])
}

model ParcelParticipant {
  id                 String    @id @default(cuid())
  customerId         String?
  parcelId           String?
  programId          String?
  name               String
  participantPhone   String?
  targetAmount       Decimal   @db.Decimal(12, 2)
  regionId           String?
  salePrice          Decimal   @default(0) @db.Decimal(12, 2)
  grossMargin        Decimal   @default(0) @db.Decimal(12, 2)
  managerCommission  Decimal   @default(0) @db.Decimal(12, 2)
  commissionStatus   String    @default("PENDING")
  contributionAmount Decimal   @db.Decimal(12, 2)
  frequency          String    @default("DAILY")
  startDate          DateTime  @default(now())
  endDate            DateTime?
  status             String    @default("ACTIVE")
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  parcel            Parcel?              @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  program           ParcelProgram?       @relation(fields: [programId], references: [id], onDelete: SetNull)
  contributions     ParcelContribution[]
  collectionEntries CollectionEntry[]
  region            ParcelRegion?        @relation("RegionParticipants", fields: [regionId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([parcelId])
  @@index([programId])
  @@index([regionId])
}

model ParcelContribution {
  id            String   @id @default(cuid())
  participantId String
  amount        Decimal  @db.Decimal(12, 2)
  paidAt        DateTime @default(now())
  note          String?
  createdAt     DateTime @default(now())

  participant ParcelParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@index([paidAt])
}

model CollectionSession {
  id             String    @id @default(cuid())
  regionId       String
  managerId      String
  collectionDate DateTime  @default(now())
  status         String    @default("SUBMITTED")
  expectedAmount Decimal   @default(0) @db.Decimal(12, 2)
  actualCash     Decimal?
  difference     Decimal?
  note           String?
  verifiedAt     DateTime?
  verifiedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  region     ParcelRegion      @relation(fields: [regionId], references: [id], onDelete: Cascade)
  manager    User              @relation("CollectionManager", fields: [managerId], references: [id], onDelete: Restrict)
  verifiedBy User?             @relation("CollectionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  entries    CollectionEntry[]

  @@index([regionId, collectionDate])
  @@index([managerId, collectionDate])
}

model CollectionEntry {
  id            String   @id @default(cuid())
  sessionId     String
  participantId String
  amount        Decimal  @db.Decimal(12, 2)
  note          String?
  createdAt     DateTime @default(now())

  session     CollectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant ParcelParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantId])
  @@index([participantId])
}

model ParcelItem {
  id        String  @id @default(cuid())
  parcelId  String
  variantId String
  quantity  Int
  notes     String?

  parcel  Parcel         @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([parcelId, variantId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  type          OrderType
  status        OrderStatus @default(PENDING)
  customerId    String?
  userId        String?
  subtotal      Decimal     @db.Decimal(12, 2)
  discount      Decimal     @default(0) @db.Decimal(12, 2)
  shippingCost  Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  paymentMethod String      @default("CASH")
  paymentStatus String      @default("PAID")
  paidAmount    Decimal     @default(0) @db.Decimal(12, 2)
  notes         String?
  whatsappLink  String?
  voidReason    String?
  voidedById    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customer       Customer?            @relation(fields: [customerId], references: [id])
  user           User?                @relation(fields: [userId], references: [id])
  voidedBy       User?                @relation("OrderVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  items          OrderItem[]
  financeEntries FinanceTransaction[]
  debtRecord     DebtRecord?
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String?
  variantId      String?
  parcelId       String?
  eventPackageId String?
  name           String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  order        Order           @relation(fields: [orderId], references: [id])
  product      Product?        @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  parcel       Parcel?         @relation(fields: [parcelId], references: [id])
  eventPackage EventPackage?   @relation(fields: [eventPackageId], references: [id])
}

model FinanceTransaction {
  id            String          @id @default(cuid())
  orderId       String?
  userId        String?
  accountId     String?
  categoryId    String?
  type          TransactionType
  amount        Decimal         @db.Decimal(14, 2)
  description   String
  // Kept for backward compatibility; new records use categoryId.
  category      String?
  paymentMethod String?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())

  order       Order?                    @relation(fields: [orderId], references: [id])
  user        User?                     @relation(fields: [userId], references: [id])
  account     FinanceAccount?           @relation(fields: [accountId], references: [id])
  categoryRef FinanceCategory?          @relation("TransactionCategory", fields: [categoryId], references: [id])
  debtRecord  DebtRecord?
  splits      FinanceTransactionSplit[]
  attachments FinanceAttachment[]
  tags        FinanceTransactionTag[]
  approvals   FinanceApproval[]

  @@index([accountId, createdAt])
  @@index([categoryId, createdAt])
}

model DebtRecord {
  id                   String    @id @default(cuid())
  customerId           String
  orderId              String?   @unique
  amount               Decimal   @db.Decimal(12, 2)
  paidAmount           Decimal   @default(0) @db.Decimal(12, 2)
  paidAt               DateTime?
  status               String    @default("OPEN")
  dueDate              DateTime?
  description          String?
  financeTransactionId String?   @unique
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer           Customer            @relation(fields: [customerId], references: [id])
  order              Order?              @relation(fields: [orderId], references: [id])
  financeTransaction FinanceTransaction? @relation(fields: [financeTransactionId], references: [id])
}

model FinanceCategory {
  id        String          @id @default(cuid())
  name      String
  type      TransactionType
  icon      String?
  isDefault Boolean         @default(false)
  deletedAt DateTime?
  createdAt DateTime        @default(now())

  transactions          FinanceTransaction[]      @relation("TransactionCategory")
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  splits                FinanceTransactionSplit[]
  quickTemplates        FinanceQuickTemplate[]

  @@unique([name, type])
}

model FinanceAccount {
  id           String    @id @default(cuid())
  name         String
  type         String
  startBalance Decimal   @default(0) @db.Decimal(14, 2)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  transactions          FinanceTransaction[]
  transfersOut          AccountTransfer[]      @relation("TransferFrom")
  transfersIn           AccountTransfer[]      @relation("TransferTo")
  recurringTransactions RecurringTransaction[]
  reconciliations       CashReconciliation[]
  quickTemplates        FinanceQuickTemplate[]
}

model AccountTransfer {
  id            String   @id @default(cuid())
  fromAccountId String
  toAccountId   String
  amount        Decimal  @db.Decimal(14, 2)
  note          String?
  createdAt     DateTime @default(now())

  fromAccount FinanceAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount   FinanceAccount @relation("TransferTo", fields: [toAccountId], references: [id])

  @@index([fromAccountId, createdAt])
  @@index([toAccountId, createdAt])
}

model Budget {
  id          String    @id @default(cuid())
  categoryId  String
  month       Int
  year        Int
  limitAmount Decimal   @db.Decimal(14, 2)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  category FinanceCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, month, year])
}

model RecurringTransaction {
  id          String          @id @default(cuid())
  type        TransactionType
  amount      Decimal         @db.Decimal(14, 2)
  description String
  categoryId  String?
  accountId   String?
  frequency   String
  dayOfMonth  Int?
  startDate   DateTime
  endDate     DateTime?
  lastRunAt   DateTime?
  isActive    Boolean         @default(true)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())

  category FinanceCategory? @relation(fields: [categoryId], references: [id])
  account  FinanceAccount?  @relation(fields: [accountId], references: [id])
}

model SavingsGoal {
  id           String    @id @default(cuid())
  userId       String
  name         String
  targetAmount Decimal   @db.Decimal(14, 2)
  dailyAmount  Decimal   @db.Decimal(14, 2)
  status       String    @default("ACTIVE")
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  user     User             @relation(fields: [userId], references: [id])
  deposits SavingsDeposit[]
}

model SavingsDeposit {
  id          String   @id @default(cuid())
  goalId      String
  amount      Decimal  @db.Decimal(14, 2)
  depositDate DateTime @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, depositDate])
}

model CashReconciliation {
  id            String   @id @default(cuid())
  accountId     String
  systemBalance Decimal  @db.Decimal(14, 2)
  physicalCount Decimal  @db.Decimal(14, 2)
  difference    Decimal  @db.Decimal(14, 2)
  note          String?
  userId        String?
  createdAt     DateTime @default(now())

  account FinanceAccount @relation(fields: [accountId], references: [id])
  user    User?          @relation(fields: [userId], references: [id])
}

model FinanceTag {
  id           String                  @id @default(cuid())
  name         String                  @unique
  color        String?
  deletedAt    DateTime?
  createdAt    DateTime                @default(now())
  transactions FinanceTransactionTag[]
}

model FinanceTransactionTag {
  transactionId String
  tagId         String
  transaction   FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           FinanceTag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

model FinanceTransactionSplit {
  id            String             @id @default(cuid())
  transactionId String
  categoryId    String
  amount        Decimal            @db.Decimal(14, 2)
  note          String?
  transaction   FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category      FinanceCategory    @relation(fields: [categoryId], references: [id])
}

model FinanceAttachment {
  id            String             @id @default(cuid())
  transactionId String
  fileUrl       String
  fileType      String
  ocrRawText    String?
  createdAt     DateTime           @default(now())
  transaction   FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model FinanceReminder {
  id        String   @id @default(cuid())
  type      String
  refId     String?
  title     String
  dueDate   DateTime
  channel   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model FinanceApproval {
  id            String              @id @default(cuid())
  transactionId String?
  requestedById String
  approvedById  String?
  amount        Decimal             @db.Decimal(14, 2)
  description   String
  status        String              @default("PENDING")
  reason        String?
  createdAt     DateTime            @default(now())
  decidedAt     DateTime?
  transaction   FinanceTransaction? @relation(fields: [transactionId], references: [id])
  requestedBy   User                @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  approvedBy    User?               @relation("ApprovalApprovedBy", fields: [approvedById], references: [id])
}

model FinanceAuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  userId     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
}

model NetWorthItem {
  id        String    @id @default(cuid())
  name      String
  kind      String
  value     Decimal   @db.Decimal(16, 2)
  isAuto    Boolean   @default(false)
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

  history NetWorthItemHistory[]
}

model NetWorthItemHistory {
  id        String   @id @default(cuid())
  itemId    String
  amount    Decimal  @db.Decimal(16, 2)
  addedAt   DateTime @default(now())

  item NetWorthItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, addedAt])
}

model NetWorthSnapshot {
  id             String   @id @default(cuid())
  totalAsset     Decimal  @db.Decimal(16, 2)
  totalLiability Decimal  @db.Decimal(16, 2)
  netWorth       Decimal  @db.Decimal(16, 2)
  capturedAt     DateTime @default(now())
}

model FinanceQuickTemplate {
  id          String          @id @default(cuid())
  userId      String
  label       String
  type        TransactionType
  amount      Decimal?        @db.Decimal(14, 2)
  description String
  categoryId  String?
  accountId   String?
  icon        String?
  usageCount  Int             @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime        @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account  FinanceAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model FinanceLoggingStreak {
  id              String    @id @default(cuid())
  userId          String    @unique
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastLoggedDate  DateTime?
  totalDaysLogged Int       @default(0)

  user User @relation(fields: [userId], references: [id])
}

model WhatsappFinanceSession {
  phoneNumber            String   @id
  lastTransactionId      String?
  pendingCategoryConfirm Json?
  updatedAt              DateTime @updatedAt
}

model PromoCampaign {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  discountType  String    @default("PERCENT")
  discountValue Decimal   @db.Decimal(12, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SiteProfile {
  id        String   @id @default("main")
  headline  String
  story     String
  photoUrl  String?
  updatedAt DateTime @updatedAt
}

model StockOpname {
  id            String   @id @default(cuid())
  variantId     String
  systemQty     Int
  physicalQty   Int
  difference    Int
  note          String?
  performedById String
  createdAt     DateTime @default(now())

  variant     ProductVariant @relation(fields: [variantId], references: [id])
  performedBy User           @relation(fields: [performedById], references: [id])

  @@index([variantId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  field       String
  oldValue    String?
  newValue    String?
  changedById String
  createdAt   DateTime @default(now())

  changedBy User @relation(fields: [changedById], references: [id])

  @@index([entityId, createdAt])
}

model EventPackage {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  imageUrl      String?
  price         Decimal  @db.Decimal(12, 2)
  isManualPrice Boolean  @default(false)
  isCustom      Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items      EventPackageItem[]
  orderItems OrderItem[]
}

model EventPackageItem {
  id             String @id @default(cuid())
  eventPackageId String
  variantId      String
  quantity       Int

  eventPackage EventPackage   @relation(fields: [eventPackageId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([eventPackageId, variantId])
}

model SiteContent {
  id          String          @id @default(cuid())
  type        SiteContentType
  title       String
  slug        String          @unique
  content     String
  sortOrder   Int             @default(0)
  isPublished Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}
